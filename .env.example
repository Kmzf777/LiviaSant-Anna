# Copie para .env.local e preencha. Nenhum destes valores vai para o repositório.

# URL pública do site. Alimenta metadata, sitemap, robots, JSON-LD e OG images.
NEXT_PUBLIC_SITE_URL="https://liviasantanna.com.br"

# Resend — envio do formulário de contato.
# Sem esta chave o formulário FALHA EXPLICITAMENTE em produção. Ele nunca
# retorna sucesso falso: um formulário que finge ter enviado é pior do que um
# formulário quebrado.
RESEND_API_KEY=""
CONTATO_EMAIL_DESTINO=""
CONTATO_EMAIL_REMETENTE=""

# Permite que <PlaceholderImagem /> renderize em build de produção.
# Mantenha VAZIO. Existe só para preview na Vercel enquanto as fotos reais
# não chegam — ver PENDENCIAS.md.
PERMITIR_PLACEHOLDERS=""
