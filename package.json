{
  "name": "site-livia-santanna",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fontes": "node scripts/baixar-switzer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:termos": "tsx scripts/verificar-termos.ts",
    "verify:contraste": "tsx scripts/verificar-contraste.ts",
    "verify:cores": "tsx scripts/verificar-cores.ts",
    "verify:bodoni": "tsx scripts/verificar-bodoni.ts",
    "verify:html": "tsx scripts/verificar-html.ts",
    "verify": "pnpm verify:termos && pnpm verify:contraste && pnpm verify:cores && pnpm verify:bodoni",
    "check": "pnpm typecheck && pnpm lint && pnpm verify && pnpm test",
    "check:full": "pnpm check && pnpm build && pnpm verify:html && pnpm test:e2e"
  },
  "dependencies": {
    "motion": "^12.23.12",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
